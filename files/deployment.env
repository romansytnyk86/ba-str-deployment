# ==============================================================================
#
#  deployment.env  —  SGB II Freigabe Maintenance Window
#  Replaces: BAT + Command Manager + ProjectMerge.exe workflow (CHG000025131)
#
#  HOW TO USE THIS FILE
#  ────────────────────
#  This is the ONLY file you need to edit before running the maintenance window.
#  All other Python files are fixed — do not modify them.
#
#  BEFORE EVERY MAINTENANCE WINDOW:
#    1. Update Section 5  →  new catalog suffix strings (changes each month)
#
#  FIRST-TIME SETUP ONLY:
#    2. Fill in Section 1  →  target environment URL + credentials
#    3. Fill in Section 2  →  source environment URL + credentials
#    4. Verify Section 3   →  project names match what exists in MicroStrategy
#    5. Verify Section 4   →  security role and group names
#
#  USEFUL COMMANDS  (run from the freigabe_skripte/ folder):
#    python main.py list-security   →  print available role/group names from target
#    python main.py preflight       →  validate everything before starting (read-only)
#    python main.py start-01        →  Phase 1: revoke access, disconnect users, clear caches
#    python main.py start-02        →  Phase 2: unload, update DB, load, merge, schema
#    python main.py ende            →  Phase 3: restore user access
#
#  SECURITY NOTE:
#    Passwords stored here are in plain text. If you prefer not to store them,
#    leave MSTR_PASSWORD / SOURCE_MSTR_PASSWORD blank — the script will prompt
#    you securely at runtime instead.
#
# ==============================================================================


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 1 — TARGET ENVIRONMENT  (Freigabe / Production)
#
#  This is the environment users work in. It is the DESTINATION of the merge.
#  → Changes here only needed if the server URL or admin account changes.
# ══════════════════════════════════════════════════════════════════════════════

# Full URL to the MicroStrategy Library REST API on the Freigabe (target) server.
# Must end with /MicroStrategyLibrary/
MSTR_BASE_URL=https://controlling-plattform-test.cloud.strategy.com/MicroStrategyLibrary/

# Administrator username on the Freigabe environment.
MSTR_USERNAME=s107_ctrl_platform_administrator

# Administrator password on the Freigabe environment.
# Leave blank to be prompted securely in the terminal when the script runs.
MSTR_PASSWORD=Strategy1234

# Login mode for the Freigabe environment.
# 1 = Standard MicroStrategy username/password  ← use this for cloud environments
# 16 = LDAP/Active Directory
# 8  = Trusted (token-based, no password needed)
MSTR_LOGIN_MODE=1


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 2 — SOURCE ENVIRONMENT  (Integration)
#
#  This is the development/integration environment. It is the SOURCE of the merge.
#  Objects are copied FROM this environment TO the Freigabe environment above.
#  → Changes here only needed if the server URL or admin account changes.
# ══════════════════════════════════════════════════════════════════════════════

# Full URL to the MicroStrategy Library REST API on the Integration (source) server.
# Must end with /MicroStrategyLibrary/
SOURCE_MSTR_BASE_URL=https://controlling.cloud.strategy.com/MicroStrategyLibrary/

# Administrator username on the Integration environment.
SOURCE_MSTR_USERNAME=s107_ctrl_prd_administrator

# Administrator password on the Integration environment.
# Leave blank to be prompted securely in the terminal when the script runs.
SOURCE_MSTR_PASSWORD=BIadminGeneric

# Login mode for the Integration environment. Same options as MSTR_LOGIN_MODE above.
SOURCE_MSTR_LOGIN_MODE=1


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 3 — PROJECT LIST
#
#  All 6 SGB II projects affected by the maintenance window.
#  → Rarely needs changing. Only update if projects are renamed or added/removed.
#
#  OPTIONAL: define reusable project groups in PROJECT_GROUPS and reference
#  them with @GroupName in PROJECTS / CACHE_CLEAR_PROJECTS / MERGE_PROJECTS.
#
#  To check exact names: python main.py preflight  (step 2 prints found IDs)
# ══════════════════════════════════════════════════════════════════════════════

# Optional reusable project groups.
# Format: GroupName=Project 1|Project 2;Other Group=Project 3|Project 4
# Use @GroupName in PROJECTS, CACHE_CLEAR_PROJECTS, MERGE_PROJECTS.
#
# SGB II     → the four S2S-family projects
# SGB III    → standard monthly SGB III projects
# SGB III kal → calendar-monthly SGB III projects
PROJECT_GROUPS=SGB II=SGB II S2S|SGB II S2S ZD|SGB II S2S Relational|SGB II S2S ZD CON;SGB III=SGB III BioData 2026|SGB III GPZ 2026;SGB III kal=SGB III BioData 2026|SGB III Bio LBB

# All projects that will be:
#   - security role revoked/granted  (start-01 / ende)
#   - disconnected and unloaded/loaded  (start-01 / start-02)
#   - schema updated  (start-02)
# Order controls the batching: first 2 = batch 1, next 2 = batch 2, last 2 = batch 3.
# Falke Rechtsbehelfe and MaEnde are listed individually; the remaining 4 share the @SGB II group.
PROJECTS=SGB II Falke Rechtsbehelfe,@SGB II,SGB II MaEnde

# Projects for which caches are fully deleted (report + element + document).
# Only SGB II S2S Relational is active per the original CM script.
# To add more, separate with commas.  To disable all: leave blank.
CACHE_CLEAR_PROJECTS=SGB II S2S Relational


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 4 — SECURITY ROLE & GROUP
#
#  The role that is revoked from users at the start (start-01) and
#  re-granted at the end (ende) of the maintenance window.
#  → Rarely needs changing. Only update if the role or group is renamed.
#
#  To find exact names: run  python main.py list-security
# ══════════════════════════════════════════════════════════════════════════════

# The security role to revoke/grant. Must match exactly (case-sensitive).
# Replaces: REVOKE/GRANT SECURITY ROLE "..." in CM_Start_01.scp / CM_Ende_01.scp
SECURITY_ROLE=Normal Users

# The user group to revoke from / grant to. Must match exactly (case-sensitive).
SECURITY_GROUP=SGB II Projektzugriff


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 5 — DB CONNECTION CATALOG STRINGS  ← UPDATE THIS EACH MONTH
#
#  Each maintenance window uses a new monthly data catalog (e.g. 202602 → 202603).
#  This replaces manually editing CM_Start_Wartungsfenster_04.scp each month.
#
#  FORMAT:  connection_name|new_catalog_name
#  Separate multiple entries with commas. No spaces around the | separator.
#
#  WHAT TO CHANGE: update the catalog suffix at the end of each value.
#  Example:  con_s2s_202602  →  con_s2s_202603  for the March cycle.
#
#  Replaces: ALTER DBCONNECTION "..." CATALOG "..." in CM_Start_04.scp
# ══════════════════════════════════════════════════════════════════════════════

DB_CATALOG_CHANGES=SGB II - S2S - Mn T0 - MSAS@DST_BICOMSTRSQLSVC|con_s2s_mn_202502,SGB II - S2S - Mn - MSAS@DST_BICOMSTRSQLSVC|con_s2s_mn_202602,SGB II - Falke Rechtsbehelfe - Falke Rechtsbehelfe - MSAS@DST_BICOMSTRSQLSVC|con_falke_sgbii_202602,SGB II - S2S - S2S - MSAS@DST_BICOMSTRSQLSVC|con_s2s_202602,SGB II - S2S ZD CON - S2S ZD CON - MSAS@DST_BICOMSTRSQLSVC|con_s2s_zd_202602,SGB II - S2S ZD - S2S ZD - MSAS@DST_BICOMSTRSQLSVC|LST_II_ZD_202602

# DB connections whose properties are printed to the log after all changes
# are applied (informational only — nothing is changed).
# Replaces: LIST PROPERTIES FOR DBCONNECTION "..." in CM_Start_05.scp
DB_CONNECTIONS_TO_LIST=SGB II - Falke Rechtsbehelfe - Falke Rechtsbehelfe - MSAS@DST_BICOMSTRSQLSVC,SGB II - MaEnde - MaEnde - MSAS@DST_BICOMSTRSQLSVC,SGB II - S2S - S2S - MSAS@DST_BICOMSTRSQLSVC,SGB II - S2S - Mn - MSAS@DST_BICOMSTRSQLSVC,SGB II - S2S - Mn T0 - MSAS@DST_BICOMSTRSQLSVC,SGB II - S2S ZD CON - S2S ZD CON - MSAS@DST_BICOMSTRSQLSVC,SGB II - S2S ZD - S2S ZD - MSAS@DST_BICOMSTRSQLSVC


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 6 — PROJECT MERGE  (ProjectMerge.exe replacement)
#
#  Controls which projects are merged from Integration → Freigabe.
#  Replaces: projectmerge.exe + PM_*.xml files
#
#  In the original BAT only "SGB II S2S" was active (others were commented out).
#  To activate additional projects, add them to MERGE_PROJECTS separated by commas.
#  Available merge configs exist for:
#    SGB II S2S, SGB II Falke Rechtsbehelfe, SGB II MaEnde,
#    SGB II S2S ZD, SGB II S2S ZD CON
#
#  → Rarely needs changing unless the merge scope changes.
# ══════════════════════════════════════════════════════════════════════════════

# Comma-separated list of projects to merge Integration → Freigabe.
# Only projects listed here will be merged; all others are silently skipped.
# Supports @GroupName references from PROJECT_GROUPS.
# Set to empty to disable all merges.
MERGE_PROJECTS=SGB II S2S

# Prefix used when naming migration packages created in MicroStrategy.
# These are temporary objects created during merge and cleaned up automatically.
MERGE_NAME_PREFIX=SGB II Freigabe Integration2Freigabe


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 7 — TIMING / WAIT DELAYS  (seconds)
#
#  Waits between batches give the Intelligence Server time to process.
#  These mirror the original EXECUTE PROCEDURE wait_X_seconds(...) calls.
#  → Only change if the server is slower/faster than expected.
# ══════════════════════════════════════════════════════════════════════════════

# Wait after unloading batch 1 (SGB II Falke Rechtsbehelfe + SGB II S2S)
UNLOAD_BATCH1_DELAY=20

# Wait after unloading batch 2 (SGB II S2S Relational + SGB II S2S ZD)
UNLOAD_BATCH2_DELAY=20

# Wait after unloading batch 3 (SGB II S2S ZD CON + SGB II MaEnde)
UNLOAD_BATCH3_DELAY=15

# Wait after all DB catalog changes have been applied before loading projects
DB_CHANGE_DELAY=25

# Wait after each load batch
LOAD_BATCH_DELAY=20


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 8 — EXECUTION BEHAVIOUR
#  → Usually no need to change these.
# ══════════════════════════════════════════════════════════════════════════════

# Whether to stop immediately when any step fails.
# true  = stop on first error (safer for production — prevents running dependent steps)
# false = run all steps and report all errors at the end (useful for diagnostics)
FAIL_FAST=false


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 9 — LOGGING
#  → Usually no need to change these.
# ══════════════════════════════════════════════════════════════════════════════

# Folder where log files and process reports are written (relative to freigabe_skripte/).
# Per-run JSON reports are always written to: LOG_DIR/process_reports/
LOG_DIR=logs

# Name of the rotating log file (kept for up to 5 backup files of 5 MB each).
LOG_FILE_NAME=freigabe_deployment.log
